/* 全局样式：简洁卡片式设计 */
page {
  background: #f4f5f7;
  color: #1f2328;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  line-height: 1;
  padding: 0 32rpx;
  box-sizing: border-box;
  transition: opacity 0.15s;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #07c160;
  color: #fff;
}

.btn-plain {
  background: #fff;
  color: #1f2328;
  border: 2rpx solid #e3e5e8;
}

.btn-disabled {
  opacity: 0.5;
}

.btn:active {
  opacity: 0.85;
}

.btn-row {
  display: flex;
  gap: 20rpx;
}

.btn-row .btn {
  flex: 1;
}

/* 空状态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #8a9099;
}

.empty-icon {
  font-size: 88rpx;
  line-height: 1;
  margin-bottom: 20rpx;
}

/* 处理中的过渡状态（选完照片、压缩和加载还没完成时） */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #e6e8eb;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: lite-pic-spin 0.8s linear infinite;
}

.loading-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #8a9099;
}

@keyframes lite-pic-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* 画布容器 */
.canvas-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

/*
 * 屏幕外的工作画布：导出、切图这类不希望用户看到的绘制都放这里，
 * 页面可视画布就不会出现中途变化（闪烁）。
 * 用 absolute + 负偏移而不是 fixed：原生组件不支持 position: fixed。
 */
.work-canvas {
  position: absolute;
  left: -2000px;
  top: 0;
  width: 10px;
  height: 10px;
}

/* 通用行 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
}

.row-label {
  color: #5b6169;
  flex-shrink: 0;
}

.row-value {
  color: #1f2328;
  font-variant-numeric: tabular-nums;
}

.text-tip {
  color: #8a9099;
  font-size: 24rpx;
  line-height: 1.6;
}

.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}
