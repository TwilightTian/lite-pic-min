.tip {
  margin-top: 12rpx;
}

.edit-canvas {
  display: block;
  background: #f4f5f7;
}

.empty-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #a8adb5;
}

/* 模式切换 */
.segment {
  display: flex;
  background: #f1f2f4;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.segment-item {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 28rpx;
  color: #5b6169;
  border-radius: 12rpx;
}

.segment-item.active {
  background: #fff;
  color: #1f2328;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 预览 / 结果 切换 */
.view-switch {
  display: flex;
  background: #f1f2f4;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.view-tab {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 26rpx;
  color: #5b6169;
  border-radius: 12rpx;
}

.view-tab.active {
  background: #fff;
  color: #1f2328;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.action-row {
  margin-top: 20rpx;
}
