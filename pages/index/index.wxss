.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.hero {
  padding: 24rpx 8rpx 32rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-desc {
  margin-top: 12rpx;
  color: #8a9099;
  font-size: 26rpx;
}

/*
 * 卡片区：卡片全是绝对定位，宽高位置由 JS 写进行内样式（index.ts 的 computeGeometry）。
 * 换位时 transform 一变，下面的 transition 就让卡片滑过去；
 * 被拖动的那张额外挂 .feature-dragging（transition: none），紧跟手指不做补间。
 */
.grid {
  position: relative;
}

.feature {
  position: absolute;
  top: 0;
  left: 0;
  box-sizing: border-box;
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
  transition: transform 0.26s cubic-bezier(0.22, 0.8, 0.3, 1), box-shadow 0.2s ease, opacity 0.15s;
}

.feature-hover {
  opacity: 0.88;
}

/* 被按住的那张：抬起来（阴影 + 轻微放大，放大写在行内 transform 里） */
.feature-dragging {
  z-index: 5;
  transition: none;
  will-change: transform;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.16);
}

.feature-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 14rpx;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.feature-desc {
  font-size: 22rpx;
  color: #8a9099;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 排序提示 / 拖拽工具栏：两者占同一位置，进出拖拽模式时下面的内容不会跳 */
.order-tip {
  margin-top: 20rpx;
  text-align: center;
  color: #a2a8b0;
  font-size: 22rpx;
}

.drag-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 14rpx 20rpx;
  border-radius: 20rpx;
  background: #e8f7ee;
  animation: drag-bar-in 0.22s ease-out;
}

.drag-text {
  font-size: 24rpx;
  color: #07964f;
}

.drag-done {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 4rpx 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #07c160;
}

@keyframes drag-bar-in {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.tips {
  margin-top: 24rpx;
}

.tips-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.text-tip + .text-tip {
  margin-top: 8rpx;
}

.footer {
  text-align: center;
  padding: 24rpx 0 8rpx;
}

.footer-link {
  color: #8a9099;
  font-size: 26rpx;
  text-decoration: underline;
}
