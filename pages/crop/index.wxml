<view class="container">
  <!-- 选图与预览合并：没图时整块可点 -->
  <view class="card">
    <view class="canvas-wrap" style="height: {{displayH}}px;" bindtap="onTapStage">
      <canvas
        wx:if="{{hasImage}}"
        type="2d"
        id="editCanvas"
        class="edit-canvas"
        style="width: {{displayW}}px; height: {{displayH}}px;"
        catchtouchstart="onTouchStart"
        catchtouchmove="onTouchMove"
        catchtouchend="onTouchEnd"
        catchtouchcancel="onTouchEnd"
      ></canvas>
      <view wx:elif="{{working}}" class="loading-state">
        <view class="loading-spinner"></view>
        <view class="loading-text">正在处理照片…</view>
      </view>
      <view wx:else class="empty">
        <view class="empty-icon">＋</view>
        <view>点击选择照片</view>
      </view>
    </view>
    <view wx:if="{{hasImage}}" class="text-tip tip">
      单指拖动照片，双指放大缩小，框住的画面才会被保留。
    </view>
    <view wx:if="{{hasImage}}" class="text-tip tip">{{imageTip}}</view>
    <view wx:else class="text-tip tip">{{advice}}</view>
  </view>

  <!-- 裁剪比例常驻：没选照片也能先选好 -->
  <view class="card">
    <view class="card-title">裁剪比例</view>
    <view class="ratio-row">
      <view
        wx:for="{{ratios}}"
        wx:key="key"
        class="ratio-item {{crop.ratio === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onPickRatio"
      >{{item.label}}</view>
    </view>
    <view class="text-tip tip">选「自由」可以自己框大小，其他选项是固定比例。</view>

    <!-- 更多设置 -->
    <view class="more-toggle" bindtap="onToggleMore">
      <text class="more-title">更多设置</text>
      <text class="more-arrow">{{moreOpen ? '收起 ▴' : '展开 ▾'}}</text>
    </view>

    <block wx:if="{{moreOpen}}">
      <slider-control
        label="照片大小"
        value="{{scaleDisplay}}"
        min="1"
        max="6"
        step="0.1"
        precision="{{1}}"
        unit="x"
        data-field="scale"
        bindchanging="onSliderChanging"
        bindchange="onSliderChange"
      />

      <block wx:if="{{crop.ratio === 'free'}}">
        <slider-control
          label="框的宽度"
          value="{{pct.freeWidth}}"
          min="20"
          max="100"
          step="1"
          display="{{px.freeWidth + 'px'}}"
          data-field="freeWidth"
          bindchanging="onSliderChanging"
          bindchange="onSliderChange"
        />
        <slider-control
          label="框的高度"
          value="{{pct.freeHeight}}"
          min="20"
          max="100"
          step="1"
          display="{{px.freeHeight + 'px'}}"
          data-field="freeHeight"
          bindchanging="onSliderChanging"
          bindchange="onSliderChange"
        />
      </block>
    </block>
  </view>

  <!-- 操作按钮常驻 -->
  <view class="card">
    <view
      class="btn btn-primary {{hasImage && !exporting ? '' : 'btn-disabled'}}"
      bindtap="onExport"
    >保存到相册</view>
    <view class="btn-row reset-row">
      <view class="btn btn-plain" bindtap="onReset">还原照片位置</view>
      <view class="btn btn-plain" bindtap="onRepick">{{hasImage ? '换一张照片' : '选择照片'}}</view>
    </view>
    <view class="text-tip tip">保存下来的就是框里的画面，别的地方不会保留。</view>
  </view>

  <!-- 屏幕外的工作画布：导出在这里画，用户看不到 -->
  <canvas wx:if="{{hasImage}}" type="2d" id="workCanvas" class="work-canvas"></canvas>

  <view class="safe-bottom" />
</view>
